module Didit
  class Authentication
    module Issuer
      LOOPBACK_HOSTS: Array[String]
      PREFIXES: Hash[String, bool]
      UNSAFE: Regexp

      def self?.normalize: (untyped issuer, ?allow_loopback_http: bool) -> String
      def self?.from_publishable_key: (untyped publishable_key) -> String
      def self?.loopback?: (String host) -> bool
      def self?.decode_issuer: (String prefix, String encoded) -> String
      def self?.parse: (String text) -> URI::HTTP
      def self?.invalid: (String text) -> bot
    end
  end
end
