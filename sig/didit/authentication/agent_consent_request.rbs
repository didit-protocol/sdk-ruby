module Didit
  class Authentication
    module AgentConsentRequest
      CONSENT_PATH: String
      OPTIONS_PATH: String
      DECISIONS: Array[String]
      ASSERTION_SECRETS: Array[String]

      def self.build: (String challenge, untyped decision, untyped assertion, untyped scopes) -> [Hash[String, untyped], Array[String]]
      def self.checked_assertion: (untyped assertion) -> Hash[untyped, untyped]
      def self.checked_scopes: (untyped scopes) -> Array[String]
      def self.assertion_secrets: (Hash[untyped, untyped] assertion) -> Array[String]
    end
  end
end
