module Didit
  class Authentication
    module AgentConsentRequest
      CONSENT_PATH: String
      OPTIONS_PATH: String
      UUID: Regexp
      LIFETIMES: Array[Integer]
      DECISIONS: Array[String]

      def self.build: (String challenge, untyped decision, untyped assertion, untyped scopes, ?Hash[Symbol, untyped] extras) -> [Hash[String, untyped], Array[String]]
      def self.checked_assertion: (untyped assertion) -> Hash[untyped, untyped]
      def self.checked_organization_ids: (untyped ids) -> Array[String]
      def self.checked_lifetime: (untyped lifetime) -> Integer
      def self.checked_scopes: (untyped scopes) -> Array[String]
      def self.assertion_secrets: (untyped value) -> Array[String]
    end
  end
end
